<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>@ViewBag.Title</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            color: #333;
        }

        .main-container {
            width: 80%;
            margin: 30px auto;
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header {
            background-color: #337ab7;
            color: white;
            padding: 20px;
            text-align: center;
        }

            .header h1 {
                margin: 0;
                font-size: 28px;
            }

        .content {
            padding: 25px;
            min-height: 350px;
        }

        .footer {
            background-color: #333;
            color: white;
            padding: 15px;
            text-align: center;
        }

            .footer h3 {
                margin: 0;
                font-size: 18px;
                font-weight: normal;
            }

        hr {
            border: 0;
            border-top: 1px solid #ddd;
            margin: 0;
        }
    </style>
</head>

<body>

    <div class="main-container">

        <div class="header">
            <h1>Feedback Management Module</h1>
        </div>

        <div class="content">
            @RenderBody()
        </div>

        <div class="footer">
            <h3>Department CE Marwadi University</h3>
        </div>

    </div>

</body>
</html>