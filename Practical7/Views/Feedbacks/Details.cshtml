@model Practical7.Models.Feedback

@{
    ViewBag.Title = "Feedback Details";
    Layout = "~/Views/Shared/_FeedbackS1Page1.cshtml";
}

<h2>Student Feedback Details</h2>

<p>
    <strong>Student Name:</strong>
    @Model.StudentName
</p>

<p>
    <strong>Student Email:</strong>
    @Model.StudentEmail
</p>

<p>
    <strong>Course:</strong>
    @Model.Course
</p>

<p>
    <strong>Rating:</strong>
    @Model.Rating
</p>

<p>
    <strong>Comment:</strong>
    @Model.Comment
</p>

<br />

@Html.ActionLink("Back to Feedback Form", "Index", "Feedbacks")